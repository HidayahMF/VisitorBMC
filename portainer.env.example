# Public URL used by the browser. With the single nginx entrypoint this is also
# the API origin, for example https://visitorbmc.example.com.
FRONTEND_URL=https://visitorbmc.example.com
APP_PORT=8080

# SQL Server reachable from the Docker host/container network.
DB_SERVER=10.19.25.27
DB_PORT=1433
DB_DATABASE=BMC
DB_USER=sa
DB_PASSWORD=CHANGE_ME
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=86400

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
UPLOAD_MAX_SIZE_MB=512
UPLOAD_ALLOWED_TYPES=mp4,mov,webm,jpg,jpeg,png,gif,pdf

HRIS_EMPLOYEE_TABLE=dbo.hris_Employee
HRIS_EMPLOYEE_NAME_COL=Name
HRIS_EMPLOYEE_NIP_COL=NIP
HRIS_EMPLOYEE_BIRTHDATE_COL=BirthDate
HRIS_SEARCH_MIN_CHARS=2
