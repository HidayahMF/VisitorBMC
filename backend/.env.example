# Server
PORT=3000

# Database (SQL Server Internal)
# Local development example:
#   DB_SERVER=localhost
#   DB_PORT=1433
#   DB_DATABASE=BMC
#   DB_USER=sa
#   DB_PASSWORD=<YOUR_DB_PASSWORD>
#
# Production (internal network):
#   DB_SERVER=10.19.25.27
#   DB_PORT=1433
#   DB_DATABASE=BMC
#   DB_USER=sa
#   DB_PASSWORD=<USER TO FILL IN>
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=BMC
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Authentication
# IMPORTANT: Replace with a strong random secret in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<GENERATE_A_STRONG_RANDOM_SECRET>
JWT_EXPIRES_IN=86400

# Cookie Configuration
# Set COOKIE_SECURE=true in production (HTTPS)
COOKIE_SECURE=false
# SameSite: 'lax' | 'strict' | 'none'
COOKIE_SAME_SITE=lax

# CORS
FRONTEND_URL=http://localhost:5173

# File Upload
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_TYPES=mp4,jpg,jpeg,png,gif

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
